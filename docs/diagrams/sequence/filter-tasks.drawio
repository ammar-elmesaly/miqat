        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User\n    participant Client as Client App\n    participant Controller as TasksController\n    participant Service as TasksService\n    participant DB as PostgreSQL DB\n    participant Cache as Redis Cache\n\n    User-&gt;&gt;Client: Select Filter Criteria (e.g., priority=HIGH, status=PENDING)\n    Client-&gt;&gt;Client: constructQueryString()\n    Client-&gt;&gt;Controller: GET /api/tasks?priority=HIGH&amp;status=PENDING [tokenValid == true]\n    Controller-&gt;&gt;Service: getFilteredTasks(userId, filterDTO)\n    \n    Service-&gt;&gt;Cache: [cacheEnabled == true] GET cached_tasks_key\n    Cache--&gt;&gt;Service: Cache Miss (null)\n    \n    Service-&gt;&gt;DB: SELECT * FROM tasks WHERE priority=&#39;HIGH&#39; AND status=&#39;PENDING&#39;\n    DB--&gt;&gt;Service: Return Matched Task Records\n    \n    %% Asynchronous background cache update\n    Service-)Cache: setCacheAsync(cached_tasks_key, results)\n    \n    Service--&gt;&gt;Controller: Return Formatted Task List DTO\n    Controller--&gt;&gt;Client: 200 OK (JSON Array)\n    Client--&gt;&gt;User: Render Filtered Tasks Board&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="41t3qkXhvVKNECW8E5eO-1">
