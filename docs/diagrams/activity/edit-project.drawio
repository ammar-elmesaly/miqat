<mxfile host="Electron">
  <diagram name="Edit Project" id="edit-project-activity">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Swimlanes -->
        <mxCell id="lane-user" value="User" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="240" height="620" as="geometry" />
        </mxCell>
        <mxCell id="lane-client" value="Client App (Web / Mobile)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="280" height="620" as="geometry" />
        </mxCell>
        <mxCell id="lane-backend" value="Backend API (Projects)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="280" height="620" as="geometry" />
        </mxCell>

        <!-- User Nodes -->
        <mxCell id="start" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane-user">
          <mxGeometry x="105" y="45" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="act-click" value="Click &quot;Edit&quot; on Project" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-user">
          <mxGeometry x="40" y="105" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="act-modify" value="Modify Project Details&#xa;(Name, Color, Description)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-user">
          <mxGeometry x="30" y="195" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Client Nodes -->
        <mxCell id="act-form" value="Display Pre-filled&#xa;Edit Project Form" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-client">
          <mxGeometry x="60" y="105" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="act-val" value="Validate Form Inputs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-client">
          <mxGeometry x="60" y="200" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dec-valid" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-client">
          <mxGeometry x="120" y="285" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="act-send" value="Send Edit Project Request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-client">
          <mxGeometry x="50" y="375" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act-update" value="Update Project Card&#xa;in Sidebar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-client">
          <mxGeometry x="50" y="475" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane-client">
          <mxGeometry x="125" y="560" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Backend Nodes -->
        <mxCell id="act-server-val" value="Server-Side Validation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-backend">
          <mxGeometry x="50" y="375" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act-updated" value="Project Updated Successfully" style="rounded=1;whiteSpace=wrap;html=1;arcSize=25;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="lane-backend">
          <mxGeometry x="50" y="475" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" edge="1" parent="1" source="start" target="act-click" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="act-click" target="act-form" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="act-form" target="act-modify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="212" />
              <mxPoint x="160" y="212" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="act-modify" target="act-val" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="act-val" target="dec-valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="[Invalid]" edge="1" parent="1" source="dec-valid" target="act-modify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="[Valid]" edge="1" parent="1" source="dec-valid" target="act-send" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="act-send" target="act-server-val" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="act-server-val" target="act-updated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="act-updated" target="act-update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="act-update" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
